# ── Redis ────────────────────────────────────────────────────────────────
# redis_four_roles 沿用本机默认 6379；compose 提供的 Redis 映射在 6380
REDIS_URL=redis://localhost:6380/0

# 可选：队列名前缀，多人共享一个 Redis 时隔离各自的 Celery 队列 / 延迟队列
# LAB_QUEUE_PREFIX=shawn

# ── PostgreSQL（docker compose up -d postgres）───────────────────────────
# SQLAlchemy 异步引擎（asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://lab:lab@localhost:55432/lab
# psycopg3 同步驱动（postgres_transactions / billing 等需要精确控制事务时序的实验）
DATABASE_PSYCOPG_URL=postgresql://lab:lab@localhost:55432/lab

# ── Kafka（docker compose up -d kafka）──────────────────────────────────
KAFKA_BOOTSTRAP=localhost:29092
